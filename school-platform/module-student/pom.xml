<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.skuli</groupId>
        <artifactId>school-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>module-student</artifactId>
    <name>module-student</name>
    <description>Student, Parent, enrolment, capacity rules</description>

    <dependencies>
        <dependency>
            <groupId>com.skuli</groupId>
            <artifactId>common-library</artifactId>
        </dependency>
        <!-- Student creation provisions a Keycloak user via module-auth's exposed API. -->
        <dependency>
            <groupId>com.skuli</groupId>
            <artifactId>module-auth</artifactId>
        </dependency>
        <!-- The enrolment capacity rule reads class capacity via module-academics' ClassCatalog. -->
        <dependency>
            <groupId>com.skuli</groupId>
            <artifactId>module-academics</artifactId>
        </dependency>
        <!-- MapStruct annotation processor: generates the *MapperImpl classes at compile time.
             'provided' keeps it off the runtime classpath; javac discovers it automatically. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
