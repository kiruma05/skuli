<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.skuli</groupId>
    <artifactId>school-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>school-platform</name>
    <description>School Platform — Spring Boot modular monolith backend</description>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
    </properties>

    <modules>
        <module>common-library</module>
        <module>module-auth</module>
        <module>module-student</module>
        <module>module-staff</module>
        <module>module-academics</module>
        <module>module-finance</module>
        <module>module-communication</module>
        <module>module-reporting</module>
        <module>module-ai-client</module>
        <module>app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>com.skuli</groupId>
                <artifactId>common-library</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.skuli</groupId>
                <artifactId>module-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.skuli</groupId>
                <artifactId>module-student</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.skuli</groupId>
                <artifactId>module-staff</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.skuli</groupId>
                <artifactId>module-academics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.skuli</groupId>
                <artifactId>module-finance</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.skuli</groupId>
                <artifactId>module-communication</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.skuli</groupId>
                <artifactId>module-reporting</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.skuli</groupId>
                <artifactId>module-ai-client</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ArchUnit (architecture tests) -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
