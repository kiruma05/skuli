# Copy this file to `.env` and fill in real values.

# --- Database ---
# App on host (npm run dev): use localhost. App in Docker: use the service name `postgres`.
DATABASE_URL=postgresql://kiruma:mypassword@localhost:5432/mydb

# --- Auth.js (NextAuth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Keycloak OIDC --- (from the Keycloak client you registered)
AUTH_KEYCLOAK_ID=school-app
AUTH_KEYCLOAK_SECRET=your_client_secret
# Format: <keycloak-url>/realms/<realm-name>
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/skuli

# --- Cloudinary (image uploads; optional) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
